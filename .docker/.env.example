COMPOSE_PROJECT_NAME=rolsys

CONTAINER_NAME=rolsys
DOMAIN=rolsys.localhost
ENTRYPOINT=web
ENTRYPOINT_VITE=web-vite
ENTRYPOINT_DB=mysql
TLS=false
DB_TLS=false
CERT_RESOLVER=letsencrypt
NETWORK=proxy

WEB_PORT=80
VITE_PORT=5173
MYSQL_PORT=3306
MYSQL_EXTERNAL_PORT=33060
PHPMYADMIN_PORT=80
REDIS_PORT=6379
MAILPIT_PORT=80
MINIO_PORT=9000
MINIO_UI_PORT=80
MINIO_PORT_EXTERNAL=9100

USERNAME=change-me-to-host-user
UID=1000
GROUP=change-me-to-host-group
ROOTPASS=change-me
INSTALL_NODE=true
INSTALL_COMPOSER=true

MYSQL_PASSWORD=change-me
MINIO_USER=minio
MINIO_PASSWORD=change-me-min-8-chars

AI_SERVICE_TOKEN=
AI_LOG_LEVEL=info
