APP_NAME="RolSys"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://rolsys.localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_STORE=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_CLIENT=predis

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AI_SERVICE_URL=http://ai-service:5000
AI_SERVICE_TIMEOUT=60
AI_SERVICE_CONNECT_TIMEOUT=5
AI_SERVICE_TOKEN=

SANCTUM_EXPIRATION=43200

VITE_HMR_HOST="app.rolsys.localhost"
